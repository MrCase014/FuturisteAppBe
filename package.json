{
  "name": "futuriste-academie-fc",
  "private": true,
  "version": "0.1.0",
  "description": "FUTURISTE ACADÉMIE FC — plateforme digitale de formation football jeunes",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@futuriste/web",
    "dev:mobile": "turbo run dev --filter=@futuriste/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,md,css}\"",
    "db:start": "bash scripts/db-local.sh start",
    "db:stop": "bash scripts/db-local.sh stop",
    "db:reset": "bash scripts/db-local.sh reset",
    "db:types": "PGHOST=${PGHOST:-/tmp} PGPORT=${PGPORT:-5433} PGUSER=${PGUSER:-postgres} node scripts/generate-db-types.mjs",
    "db:seed:generate": "node supabase/seed/generate.mjs",
    "db:test": "PGHOST=${PGHOST:-/tmp} PGPORT=${PGPORT:-5433} PGUSER=${PGUSER:-postgres} bash supabase/tests/run-rls-tests.sh"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.10.13",
    "typescript": "^5.9.3"
  }
}
