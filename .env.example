# FUTURISTE ACADÉMIE FC — modèle de configuration
# Copiez ce fichier en .env.local et remplissez-le.
# ⚠️ .env.local n'est JAMAIS envoyé sur GitHub. N'écrivez aucune vraie clé ici.

# --- Supabase (Project Settings → API) ---
# L'URL du projet s'arrête à .supabase.co : pas de /rest/v1 à la fin.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon

# La clé « service_role » contourne TOUTE la sécurité RLS. Elle n'est lue nulle
# part dans cette application, ne doit jamais approcher un navigateur, et n'a
# pas sa place dans une conversation. Elle n'est donc pas listée ici.

# --- Mobile (Expo) ---
EXPO_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon

# --- IA (Phase 12 seulement) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# --- Supervision (facultatif) ---
SENTRY_DSN=
